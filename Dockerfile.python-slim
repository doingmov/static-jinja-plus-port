ARG PYTHON_VERSION=3.10
FROM python:${PYTHON_VERSION}-slim-bookworm

ARG SOURCE_VERSION=0.1.1

WORKDIR /opt/StaticJinjaPlus

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/MrDave/StaticJinjaPlus/archive/refs/tags/${SOURCE_VERSION}.tar.gz" \
    -o /tmp/source.tar.gz \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /opt/StaticJinjaPlus \
    && rm /tmp/source.tar.gz \
    && pip install --no-cache-dir -r requirements.txt

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "main.py", "--srcpath", "templates_example"]